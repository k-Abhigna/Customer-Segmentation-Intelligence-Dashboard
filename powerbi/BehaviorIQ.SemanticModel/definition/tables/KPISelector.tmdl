/// Disconnected selector for the KPI trend chart.
table KPISelector
	lineageTag: 8aff668e-1cad-e47e-ec41-3e83d64c8ca1

	column KPI
		dataType: string
		lineageTag: c414b3bc-b03e-8bf3-fb91-f592d2e552c9
		summarizeBy: none
		isNameInferred
		sourceColumn: [KPI]
		sortByColumn: 'KPI Order'

		annotation SummarizationSetBy = Automatic

	column 'KPI Order'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 72dc3c5e-16d9-678f-9778-e18d6de35af4
		summarizeBy: none
		isNameInferred
		sourceColumn: [KPI Order]

		annotation SummarizationSetBy = Automatic

	partition KPISelector = calculated
		mode: import
		source =
				DATATABLE(
				    "KPI", STRING, "KPI Order", INTEGER,
				    {
				        {"Total Unique Visitors", 1},
				        {"Active Users", 2},
				        {"Avg Session Duration (min)", 3},
				        {"Pages per Session", 4},
				        {"Bounce Rate", 5},
				        {"Returning Visitor Rate", 6},
				        {"Conversion Rate", 7},
				        {"Engagement Score", 8}
				    }
				)
