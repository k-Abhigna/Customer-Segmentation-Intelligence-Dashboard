/// Home table for all DAX measures (organized in display folders).
table _Measures
	lineageTag: 25ba9885-f0cc-ca63-ba5b-f39bf63c752a

	measure Sessions = SUM(FactBehavior[sessions])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: fe347a55-aaf3-b345-f8ea-2d79040a83b8

	measure 'Visitor Days' = SUM(FactBehavior[visitors])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 0fef6014-2e11-9c0a-7146-ec6f9b44c494

	measure 'New Visitors' = SUM(FactBehavior[new_visitors])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 73e201cc-f477-a3c9-4835-81b4f0018110

	measure 'Returning Visitors' = SUM(FactBehavior[returning_visitors])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: e0b27c35-ba53-319c-d8ab-1bd2a7cb6d0a

	measure 'Page Views' = SUM(FactBehavior[page_views])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: d3e386cd-9168-87d4-cfff-cf9c3082c951

	measure Bounces = SUM(FactBehavior[bounces])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: d0e10f47-49e8-7ddd-982a-6acf94ee3bab

	measure 'Engaged Sessions' = SUM(FactBehavior[engaged_sessions])
		formatString: #,0
		displayFolder: 1 Base
