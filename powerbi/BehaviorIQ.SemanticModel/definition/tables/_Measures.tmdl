	measure Searches = SUM(FactBehavior[searches])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: e325a147-c15b-cc3f-e3c6-064a8960fc1e

	measure Clicks = SUM(FactBehavior[clicks])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 1a3d10e8-929f-40f4-070d-1819e523a8b4

	measure 'Scroll Events' = SUM(FactBehavior[scroll_events])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: c03522a5-bf70-0c5f-bb90-2fe833e10f11

	measure 'Landed Sessions' = SUM(FactBehavior[stage_landing])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 16edbac2-67fc-6f4b-c074-0b890a472e0d

