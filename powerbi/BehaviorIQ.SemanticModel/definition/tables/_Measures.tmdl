	measure 'Discount Value' = SELECTEDVALUE(ParamDiscount[Discount %], 0)
		formatString: 0
		displayFolder: 8 Simulated predictions
		lineageTag: 64d961ac-e1a1-cdf1-365c-e6f7e15de019

	measure 'Email Cadence Value' = SELECTEDVALUE(ParamEmail[Emails per Week], 2)
		formatString: 0
		displayFolder: 8 Simulated predictions
		lineageTag: 5a29fa00-6b87-34a7-f483-87d033d4b6e0

	measure 'Retargeting On' = IF(SELECTEDVALUE(ParamRetargeting[Consented Retargeting], "No") = "Yes", 1, 0)
		formatString: 0
		displayFolder: 8 Simulated predictions
		lineageTag: b56c641d-959d-0354-4bda-b88a158e269a

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Baseline Purchase Intent' = IF([Sessions] > 0, 1 / (1 + EXP(-(-1.6 + 4 * [Cart Rate] + 1.2 * [Engagement Score] / 100))))
		formatString: 0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: 17e6760a-f479-47f6-aefb-4c307c47d9df

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario Purchase Intent' = IF([Sessions] > 0, 1 / (1 + EXP(-(-1.6 + 4 * [Cart Rate] + 1.2 * [Engagement Score] / 100 + 0.35 * LN(1 + [Budget Change Value] / 100) + 0.006 * [Personalization Value] + 0.02 * [Discount Value] + 0.18 * [Retargeting On]))))
		formatString: 0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: 660da277-7879-adcf-b8ea-46f44026d153

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Purchase Intent Change (pts)' = ([Scenario Purchase Intent] - [Baseline Purchase Intent]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 8 Simulated predictions
		lineageTag: 40eee002-4a69-a28a-d238-a2f7372e562d

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Baseline Churn Risk' = IF([Sessions] > 0, 1 / (1 + EXP(-(1.2 - 3.2 * [Retention Rate 30d] - 1.5 * [Engagement Score] / 100))))
		formatString: 0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: 3fd5aaca-60b6-f1cd-9cd4-6c0b06517074

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario Churn Risk' = IF([Sessions] > 0, 1 / (1 + EXP(-(1.2 - 3.2 * [Retention Rate 30d] - 1.5 * [Engagement Score] / 100 + -0.1 * LN(1 + [Budget Change Value] / 100) - 0.008 * [Personalization Value] - 0.1 * ([Email Cadence Value] - 2) + 0.06 * POWER(MAX(0, [Email Cadence Value] - 4), 2) - 0.01 * [Discount Value]))))
		formatString: 0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: a5e95649-9159-a446-3819-21871dea81fa

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Churn Risk Change (pts)' = ([Scenario Churn Risk] - [Baseline Churn Risk]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 8 Simulated predictions
		lineageTag: cc8ff0e3-475a-e6d4-9f57-91d0acee69c1

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Baseline Repeat Visit Likelihood' = IF([Sessions] > 0, 1 / (1 + EXP(-(-1 + 2.6 * [Returning Visitor Rate] + 1.4 * [Engagement Score] / 100))))
		formatString: 0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: aede679a-a516-bc9a-72f5-21542771d56f

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario Repeat Visit Likelihood' = IF([Sessions] > 0, 1 / (1 + EXP(-(-1 + 2.6 * [Returning Visitor Rate] + 1.4 * [Engagement Score] / 100 + 0.15 * LN(1 + [Budget Change Value] / 100) + 0.006 * [Personalization Value] + 0.12 * ([Email Cadence Value] - 2) - 0.03 * POWER([Email Cadence Value] - 2, 2) + 0.2 * [Retargeting On]))))
		formatString: 0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: 7e29312c-4aaf-821c-746e-3ce216a75325

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Repeat Visit Likelihood Change (pts)' = ([Scenario Repeat Visit Likelihood] - [Baseline Repeat Visit Likelihood]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 8 Simulated predictions
		lineageTag: fc6c8177-b075-35b4-b762-bbc444cc2233

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Baseline Conversion Probability' = IF([Sessions] > 0, 1 / (1 + EXP(-(LN(DIVIDE(MAX(0.000001, [Conversion Rate]), 1 - [Conversion Rate]))))))
		formatString: 0.00%
		displayFolder: 8 Simulated predictions
		lineageTag: db7088a3-e31d-6054-5496-37546f668507

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario Conversion Probability' = IF([Sessions] > 0, 1 / (1 + EXP(-(LN(DIVIDE(MAX(0.000001, [Conversion Rate]), 1 - [Conversion Rate])) + 0.25 * LN(1 + [Budget Change Value] / 100) + 0.004 * [Personalization Value] + 0.035 * [Discount Value] + 0.12 * [Retargeting On]))))
		formatString: 0.00%
		displayFolder: 8 Simulated predictions
		lineageTag: 755fb71d-b7c5-e98e-be79-c4455b74e27a

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Conversion Probability Change (pts)' = ([Scenario Conversion Probability] - [Baseline Conversion Probability]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 8 Simulated predictions
		lineageTag: e4f7fa85-4293-3d45-28ac-22ddaab6bc41

	measure 'Gauge Max 100%' = 1
		formatString: 0%
		displayFolder: 8 Simulated predictions
		lineageTag: ce9f8f7a-64a6-518b-9a26-5eebbc8cd396

	measure 'Gauge Max 10%' = 0.1
		formatString: 0%
		displayFolder: 8 Simulated predictions
		lineageTag: 496d59cd-2c80-aaee-8397-a02711764589

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Traffic Multiplier' = MAX(0.3, 1 + 0.42 * LN(1 + [Budget Change Value] / 100) + 0.04 * [Retargeting On] + 0.04 * ([Email Cadence Value] - 2) / 2)
		formatString: 0.00
		displayFolder: 8 Simulated predictions
		lineageTag: bdee7c0f-974f-7a36-51e3-2b0b183c8db6

	/// Run-rate of the selected period scaled to 30 days. SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Baseline 30d Conversions' = DIVIDE([Conversions], [Days in Period]) * 30
		formatString: #,0
		displayFolder: 8 Simulated predictions
		lineageTag: fd06c5b9-4108-5d73-608b-3a8c8e5f4ae4

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario 30d Conversions' = [Baseline 30d Conversions] * DIVIDE([Scenario Conversion Probability], [Baseline Conversion Probability]) * [Traffic Multiplier]
		formatString: #,0
		displayFolder: 8 Simulated predictions
		lineageTag: d6d08cfc-91bf-f38c-321b-6cab8fe09b6e

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Baseline 30d Revenue' = [Baseline 30d Conversions] * [Average Order Value]
		formatString: \$#,0
		displayFolder: 8 Simulated predictions
		lineageTag: 74df5790-039c-e1fd-776f-06ef62ca9413

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario 30d Revenue' = [Scenario 30d Conversions] * [Average Order Value] * (1 - [Discount Value] / 100 * 0.85)
		formatString: \$#,0
		displayFolder: 8 Simulated predictions
		lineageTag: e6ca7c05-8e95-afad-9a52-e391bd68bc01

	/// SIMULATED — heuristic formula, not a trained or validated model.
	measure 'Scenario Conversions Change %' = DIVIDE([Scenario 30d Conversions], [Baseline 30d Conversions]) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 8 Simulated predictions
		lineageTag: 0064917e-5369-21ad-5371-5af9f09cb3e3

	measure 'Simulation Disclaimer' = "SIMULATED what-if forecast: transparent heuristic formulas over synthetic history. Not a validated AI/ML prediction."
		displayFolder: 8 Simulated predictions
		lineageTag: 61475b74-71d9-24c2-7dfa-562289971d8e

	/// Evidence text for each predefined analytical rule. No AI model is called.
	measure 'Insight Evidence' =
			VAR id = SELECTEDVALUE(InsightRules[Rule ID])
			RETURN
			    SWITCH(
			        id,
			        1,
			            VAR f = CALCULATE([Engagement Score], DimSegment[segment_id] = "first")
			            VAR r = CALCULATE([Engagement Score], DimSegment[segment_id] <> "first")
			            RETURN IF(NOT ISBLANK(f) && NOT ISBLANK(r) && r > f, "Returning audiences score " & FORMAT(r, "0.0") & " on engagement vs " & FORMAT(f, "0.0") & " for first-time visitors.", "Not triggered for current filters"),
			        2,
			            VAR m = CALCULATE([Cart Abandonment], DimDevice[device_id] = "mobile")
			            VAR d = CALCULATE([Cart Abandonment], DimDevice[device_id] = "desktop")
			            VAR ok = CALCULATE([Add to Cart], DimDevice[device_id] = "mobile") > 50 && CALCULATE([Add to Cart], DimDevice[device_id] = "desktop") > 50
			            RETURN IF(ok && m > d, FORMAT(m, "0.0%") & " of mobile carts do not convert vs " & FORMAT(d, "0.0%") & " on desktop.", "Not triggered for current filters"),
			        3,
			            VAR c = CALCULATE(MAX(Transitions[probability]), Transitions[from_page_id] = "compare", Transitions[to_page_id] = "cart")
			            VAR p = CALCULATE(MAX(Transitions[probability]), Transitions[from_page_id] = "product", Transitions[to_page_id] = "cart")
			            RETURN IF(c > p, FORMAT(c, "0.0%") & " of comparison views go straight to the cart vs " & FORMAT(p, "0.0%") & " from a product page.", "Not triggered for current filters"),
			        4,
			            VAR o = CALCULATE([Channel Avg Duration (min)], ChannelMix[channel] = "Organic Search")
			            VAR a = [Avg Session Duration (min)]
			            RETURN IF(o > a, "Organic sessions average " & FORMAT(o, "0.0") & " min vs " & FORMAT(a, "0.0") & " min site-wide.", "Not triggered for current filters"),
			        5,
			            VAR t = TOPN(1, VALUES(ChannelMix[channel]), [Channel Conversion Rate], DESC)
			            VAR nm = MAXX(t, ChannelMix[channel])
			            VAR v = MAXX(t, [Channel Conversion Rate])
			            RETURN IF(NOT ISBLANK(v), nm & " converts at " & FORMAT(v, "0.00%") & " vs " & FORMAT([Conversion Rate], "0.00%") & " overall.", "Not triggered for current filters"),
			        6,
			            VAR w = CALCULATE([Cart Rate], DimSegment[segment_id] = "window")
			            VAR s = [Cart Rate]
			            RETURN IF(NOT ISBLANK(w) && w < s, "Only " & FORMAT(w, "0.0%") & " of interested Window Shopper sessions add to cart (site " & FORMAT(s, "0.0%") & ").", "Not triggered for current filters"),
			        7,
			            VAR regs = FILTER(VALUES(DimRegion[region_name]), [Sessions] > 50)
			            VAR hi = TOPN(1, regs, [Conversion Rate], DESC)
			            VAR lo = TOPN(1, regs, [Conversion Rate], ASC)
			            RETURN IF(COUNTROWS(regs) > 1, MAXX(hi, DimRegion[region_name]) & " leads at " & FORMAT(MAXX(hi, [Conversion Rate]), "0.00%") & "; " & MAXX(lo, DimRegion[region_name]) & " trails at " & FORMAT(MAXX(lo, [Conversion Rate]), "0.00%") & ".", "Not triggered for current filters"),
			        8,
			            VAR c1 = [Conversion Rate]
			            VAR c0 = [Conversion Rate PP]
			            RETURN IF(NOT ISBLANK(c0), "Conversion rate " & IF(c1 >= c0, "improved", "declined") & " from " & FORMAT(c0, "0.00%") & " to " & FORMAT(c1, "0.00%") & ".", "Not triggered for current filters"),
			        9,
			            VAR MinD = MIN(DimDate[Date])
			            VAR N = INT(MAX(DimDate[Date]) - MinD) + 1
			            VAR cur = CALCULATE([Visitor Days], DimSegment[segment_id] = "atrisk")
			            VAR prv = CALCULATE([Visitor Days], DimSegment[segment_id] = "atrisk", REMOVEFILTERS(DimDate), DATESBETWEEN(DimDate[Date], MinD - N, MinD - 1))
			            RETURN IF(prv > 0 && cur > prv * 1.01, "At-Risk visitor-days grew " & FORMAT(cur / prv - 1, "0.0%") & " vs the previous period.", "Not triggered for current filters"),
			        "Not triggered for current filters"
			    )
		displayFolder: 9 Rule-based insights
		lineageTag: 345b8d07-dcd0-6bff-22b8-9730a2167bc4

	measure 'Insight Triggered' = IF(ISBLANK(SELECTEDVALUE(InsightRules[Rule ID])), BLANK(), IF([Insight Evidence] = "Not triggered for current filters", "No", "Yes"))
		displayFolder: 9 Rule-based insights
		lineageTag: 0e529260-0afe-ce49-a8d1-248dbf396f58

	measure 'Insights Triggered Count' = COUNTROWS(FILTER(VALUES(InsightRules[Rule ID]), [Insight Evidence] <> "Not triggered for current filters"))
		formatString: 0
		displayFolder: 9 Rule-based insights
		lineageTag: 0c6db719-898a-48c6-eb5c-8079c850fd23

	measure 'Insights Summary' = [Insights Triggered Count] & " of " & COUNTROWS(InsightRules) & " rules triggered for " & FORMAT([Sessions], "#,0") & " sessions in scope"
		displayFolder: 9 Rule-based insights
		lineageTag: c0a15c86-cd71-5067-8de6-06fc5a2c29a4

	measure 'Scope Label' = "Synthetic data · " & FORMAT(MIN(DimDate[Date]), "mmm d") & " – " & FORMAT(MAX(DimDate[Date]), "mmm d, yyyy") & " · " & FORMAT([Sessions], "#,0") & " sessions in scope"
		displayFolder: 2 KPIs
		lineageTag: ab2ee592-3651-a786-6476-aa53f63016dc

	column Placeholder
		dataType: int64
