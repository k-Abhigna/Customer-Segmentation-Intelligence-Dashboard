	measure 'Product Interest Sessions' = SUM(FactBehavior[stage_product_interest])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 3ec02132-5510-979b-b34f-cd4c6a0262db

	measure 'Add to Cart' = SUM(FactBehavior[add_to_cart])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: bc59662e-a1d4-1769-32ff-32fd0132b93b

	measure Checkouts = SUM(FactBehavior[checkouts])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: d2aac36f-3e3e-bb30-bf03-87edab1ddc13

	measure Conversions = SUM(FactBehavior[conversions])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 8b71506a-e8f9-5667-9c8b-efebc9052b0a

	measure 'Session Seconds' = SUM(FactBehavior[total_session_seconds])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 1d49a474-88b3-21d3-87e8-7b817d272c5f

	measure Revenue = SUM(FactBehavior[revenue])
		formatString: \$#,0
		displayFolder: 1 Base
		lineageTag: 6b22bbc2-297d-afc1-341f-0be16ab34859

	measure 'Scroll Depth Sum' = SUM(FactBehavior[scroll_depth_sum])
		formatString: #,0
		displayFolder: 1 Base
		lineageTag: 75610268-7779-ce8e-cebd-0675f2bfc228

	measure 'Days in Period' = DISTINCTCOUNT(FactBehavior[date])
		formatString: 0
		displayFolder: 1 Base
		lineageTag: 9459cfee-cabb-eace-9238-4ff87385862b

	/// Estimated unique visitors. Daily visitor counts cannot simply be summed across days, so returning visitor-days are de-duplicated with each segment's daily revisit probability.
	measure 'Total Unique Visitors' =
			VAR Days = [Days in Period]
			RETURN
			    SUMX(
			        VALUES(DimSegment[segment_id]),
			        VAR p = CALCULATE(MAX(DimSegment[daily_return_prob]))
			        VAR nv = CALCULATE([New Visitors])
			        VAR rv = CALCULATE([Returning Visitors])
			        RETURN nv + DIVIDE(rv, 1 + (Days - 1) * p)
			    )
		formatString: #,0
		displayFolder: 2 KPIs
		lineageTag: ff91dd23-b13a-a9d6-bf7d-5e7f9f1119b6

	/// Average daily visitors with an engaged session.
	measure 'Active Users' = DIVIDE([Visitor Days] * DIVIDE([Engaged Sessions], [Sessions]), [Days in Period])
		formatString: #,0
		displayFolder: 2 KPIs
		lineageTag: 49fd711e-c3f7-6a0f-f7e5-50ef3a421c82

	measure 'Avg Session Duration (min)' = DIVIDE([Session Seconds], [Sessions]) / 60
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: eb7a398e-23ef-330d-716e-ca1b333f9b59

	measure 'Pages per Session' = DIVIDE([Page Views], [Sessions])
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: 0a7f1403-5640-b7c5-2ffe-434a1758f0b5

	measure 'Bounce Rate' = DIVIDE([Bounces], [Sessions])
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: 375d0761-e007-001a-f916-298c1019b3d3

	measure 'Returning Visitor Rate' = 1 - DIVIDE([New Visitors], [Visitor Days])
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: 2f53553b-17bd-1d16-8b8c-f3f0403ec4ca

	measure 'Conversion Rate' = DIVIDE([Conversions], [Sessions])
		formatString: 0.00%
		displayFolder: 2 KPIs
		lineageTag: 6b04faa5-a1fa-ee1d-f475-a15310e2fe08

	/// Composite 0–100 score: session duration, depth, bounce, scroll depth and engaged sessions.
	measure 'Engagement Score' =
			VAR s = [Sessions]
			RETURN
			    IF(
			        s > 0,
			        100 * (
			            0.30 * MIN(1, DIVIDE([Session Seconds], s) / 480)
			            + 0.20 * MIN(1, DIVIDE([Page Views], s) / 8)
			            + 0.20 * (1 - DIVIDE([Bounces], s))
			            + 0.15 * DIVIDE([Scroll Depth Sum], [Page Views])
			            + 0.15 * DIVIDE([Engaged Sessions], s)
			        )
			    )
		formatString: 0.0
		displayFolder: 2 KPIs
		lineageTag: 1c6285ed-8a6d-3eca-4d6f-ae2487cb966e

	measure 'Avg Scroll Depth' = DIVIDE([Scroll Depth Sum], [Page Views])
		formatString: 0%
		displayFolder: 2 KPIs
		lineageTag: 37c788f6-c7a6-38de-ba06-53a7bb721fb1

	measure 'Clicks per Session' = DIVIDE([Clicks], [Sessions])
		formatString: 0.0
		displayFolder: 2 KPIs
		lineageTag: b51a778d-bdc3-3a1e-5d8c-7e59ff3064ff

	measure 'Searches per Session' = DIVIDE([Searches], [Sessions])
		formatString: 0.00
		displayFolder: 2 KPIs
		lineageTag: 2c7585f5-72a3-46c8-af63-91b1e30aca38

	/// Share of product-interest sessions that add to cart.
	measure 'Cart Rate' = DIVIDE([Add to Cart], [Product Interest Sessions])
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: d6e9936f-9709-35ec-8c59-e5e3d7842b5f

	measure 'Cart Abandonment' = 1 - DIVIDE([Conversions], [Add to Cart])
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: bf09f9f7-4daa-e74f-dfee-2d02e4dd847b

	measure 'Checkout Abandonment' = 1 - DIVIDE([Conversions], [Checkouts])
		formatString: 0.0%
		displayFolder: 2 KPIs
		lineageTag: 636978bd-f558-195e-f64c-2a59c23f90c5

	measure 'Average Order Value' = DIVIDE([Revenue], [Conversions])
		formatString: \$#,0.00
		displayFolder: 2 KPIs
		lineageTag: 3467010d-cb43-cde2-7f12-359fd9363ca3

	measure 'Retention Rate 30d' = DIVIDE(SUMX(VALUES(DimSegment[segment_id]), CALCULATE([Visitor Days]) * CALCULATE(MAX(DimSegment[retention_rate_30d]))), [Visitor Days])
		formatString: 0%
		displayFolder: 2 KPIs
		lineageTag: 50094a95-9e1f-30d0-fd9d-fa320536494f

	/// Same KPI for the equal-length period immediately before the selected dates.
	measure 'Total Unique Visitors PP' =
			VAR MinD = MIN(DimDate[Date])
			VAR MaxD = MAX(DimDate[Date])
			VAR N = INT(MaxD - MinD) + 1
			VAR DataStart = CALCULATE(MIN(DimDate[Date]), REMOVEFILTERS(DimDate))
			RETURN
			    IF(MinD - N >= DataStart, CALCULATE([Total Unique Visitors], REMOVEFILTERS(DimDate), DATESBETWEEN(DimDate[Date], MinD - N, MinD - 1)))
		formatString: #,0
		displayFolder: 3 Period comparison
		lineageTag: 734fd1f1-6565-733c-34ff-226745391772

	measure 'Total Unique Visitors Change %' = IF(NOT ISBLANK([Total Unique Visitors PP]), DIVIDE([Total Unique Visitors] - [Total Unique Visitors PP], [Total Unique Visitors PP]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Period comparison
		lineageTag: 6457e289-3c13-3d5b-4747-5abdf3b682d9

	measure 'Total Unique Visitors Change Label' =
			VAR d = [Total Unique Visitors Change %]
			RETURN
			    IF(ISBLANK(d), "no prior period in data", IF(d >= 0, "▲ ", "▼ ") & FORMAT(ABS(d), "0.0%") & " vs previous period")
		displayFolder: 3 Period comparison
		lineageTag: 60169c66-8aa2-e04e-c9ec-dc1c2033d6e9

	measure 'Total Unique Visitors Change Color' =
			VAR d = [Total Unique Visitors Change %]
			RETURN
			    SWITCH(TRUE(), ISBLANK(d), "#8792B0", d > 0, "#34D399", d = 0, "#8792B0", "#FB7185")
		displayFolder: 3 Period comparison
		lineageTag: 93e7a1d8-c642-c42d-26fc-9612673b343d

