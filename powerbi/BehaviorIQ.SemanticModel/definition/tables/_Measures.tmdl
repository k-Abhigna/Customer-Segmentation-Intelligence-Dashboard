	/// Value of the KPI picked in the KPI selector slicer.
	measure 'Selected KPI' =
			SWITCH(
			    SELECTEDVALUE(KPISelector[KPI], "Total Unique Visitors"),
			    "Total Unique Visitors", [Total Unique Visitors],
			    "Active Users", [Active Users],
			    "Avg Session Duration (min)", [Avg Session Duration (min)],
			    "Pages per Session", [Pages per Session],
			    "Bounce Rate", [Bounce Rate],
			    "Returning Visitor Rate", [Returning Visitor Rate],
			    "Conversion Rate", [Conversion Rate],
			    "Engagement Score", [Engagement Score],
			    BLANK()
			)
		formatString: #,0.00
		displayFolder: 2 KPIs
		lineageTag: a5434678-ac7f-a6a1-32e7-c64ba1b270a6

	measure 'Selected KPI Title' = "Daily trend — " & SELECTEDVALUE(KPISelector[KPI], "Total Unique Visitors")
		displayFolder: 2 KPIs
		lineageTag: b3529659-00d5-e127-e199-6d10650315aa

	/// Sessions attributed to traffic sources via the modeled segment × channel mix.
	measure 'Channel Sessions' = SUMX(ChannelMix, ChannelMix[share] * CALCULATE([Sessions], TREATAS({ChannelMix[segment_id]}, DimSegment[segment_id])))
		formatString: #,0
		displayFolder: 4 Channels
		lineageTag: b69694f6-ce80-22bf-5f56-af9324b7cadf

	measure 'Channel Conversions' = SUMX(ChannelMix, ChannelMix[conv_coef] * CALCULATE([Conversions], TREATAS({ChannelMix[segment_id]}, DimSegment[segment_id])))
		formatString: #,0
		displayFolder: 4 Channels
		lineageTag: 1de163e3-7214-396a-59be-1939020bba60

	measure 'Channel Avg Duration (min)' = DIVIDE(SUMX(ChannelMix, ChannelMix[dur_coef] * CALCULATE([Session Seconds], TREATAS({ChannelMix[segment_id]}, DimSegment[segment_id]))), [Channel Sessions]) / 60
		formatString: 0.00
		displayFolder: 4 Channels
		lineageTag: 124d539e-0976-4c9e-81be-370d08c3671b

	measure 'Channel Bounce Rate' = DIVIDE(SUMX(ChannelMix, ChannelMix[bounce_coef] * CALCULATE([Bounces], TREATAS({ChannelMix[segment_id]}, DimSegment[segment_id]))), [Channel Sessions])
		formatString: 0.0%
		displayFolder: 4 Channels
		lineageTag: 1224c38c-9e9c-a117-8642-265666d6f9d8

	measure 'Channel Conversion Rate' = DIVIDE([Channel Conversions], [Channel Sessions])
		formatString: 0.00%
		displayFolder: 4 Channels
		lineageTag: 4854a291-f8f0-b070-3aca-d2662cc8945c

	/// Filtered page views distributed to page templates using the segment page mix.
	measure 'Page Views (modeled)' = SUMX(PageMix, PageMix[weight] * CALCULATE([Page Views], TREATAS({PageMix[segment_id]}, DimSegment[segment_id])))
		formatString: #,0
		displayFolder: 5 Pages & navigation
		lineageTag: e2c09864-74b8-cb53-4825-41af53be1dce

	/// Estimated page-to-page transitions = filtered page views × transition probability.
	measure 'Est. Transitions' = SUMX(Transitions, Transitions[probability] * CALCULATE([Page Views (modeled)], TREATAS({Transitions[from_page_id]}, DimPage[page_id])))
		formatString: #,0
		displayFolder: 5 Pages & navigation
		lineageTag: 598bf5d0-c13a-af3f-eded-23523b1f3e3b

	measure 'Transition Probability' = DIVIDE([Est. Transitions], [Page Views (modeled)])
		formatString: 0.0%
		displayFolder: 5 Pages & navigation
		lineageTag: 8681964f-f85b-bcfe-ee5a-587a2380effa

	measure 'Product Views (modeled)' = SUMX(CategoryMix, CategoryMix[weight] * CALCULATE([Product Views], TREATAS({CategoryMix[segment_id]}, DimSegment[segment_id])))
		formatString: #,0
		displayFolder: 6 Preferences
		lineageTag: a7b70665-58ea-aad3-80d4-b50ec7504dee

	measure 'Category Share' = DIVIDE([Product Views (modeled)], CALCULATE([Product Views (modeled)], REMOVEFILTERS(CategoryMix[category], CategoryMix[subcategory])))
		formatString: 0.0%
		displayFolder: 6 Preferences
		lineageTag: 1033b7aa-80d1-a632-48a7-d84e4c9b0aff

	measure 'Stage Sessions' =
			SWITCH(
			    SELECTEDVALUE(JourneyStages[Stage Order]),
			    1, [Sessions],
			    2, [Landed Sessions],
			    3, [Exploring Sessions],
			    4, [Product Interest Sessions],
			    5, [Add to Cart],
			    6, [Checkouts],
			    7, [Conversions]
			)
		formatString: #,0
		displayFolder: 7 Journey
		lineageTag: 64890857-d6b7-99c7-aa3f-62d4e800e414

	measure 'Stage Conversion from Previous' =
			VAR o = SELECTEDVALUE(JourneyStages[Stage Order])
			VAR prev = CALCULATE([Stage Sessions], REMOVEFILTERS(JourneyStages), JourneyStages[Stage Order] = o - 1)
			RETURN
			    IF(o = 1, 1, DIVIDE([Stage Sessions], prev))
		formatString: 0.0%
		displayFolder: 7 Journey
		lineageTag: d97e31c5-807d-40a9-f9d2-e292fd3b217a

	measure 'Stage Drop-off' = IF(NOT ISBLANK([Stage Sessions]), 1 - [Stage Conversion from Previous])
		formatString: 0.0%
		displayFolder: 7 Journey
		lineageTag: 6d90afb7-5ea8-e3a7-62ae-ce7d72189358

	measure 'Stage Share of Sessions' = DIVIDE([Stage Sessions], [Sessions])
		formatString: 0.00%
		displayFolder: 7 Journey
		lineageTag: 1e8bcf8f-36f5-4708-77b4-23152827719d

	measure 'Journey Completion Rate' = DIVIDE([Conversions], [Sessions])
		formatString: 0.00%
		displayFolder: 7 Journey
		lineageTag: eee44979-7291-d005-f4e5-abfbde67d1d0

	measure 'Budget Change Value' = SELECTEDVALUE(ParamBudget[Budget Change %], 0)
		formatString: 0
